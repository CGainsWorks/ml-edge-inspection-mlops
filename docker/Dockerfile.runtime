# The edge runtime.
#
# What would run on the device if the device were an x86 box: inference,
# thresholding, box extraction, telemetry and the deploy agent.  No torch, no
# MLflow, no dataset generator -- 220 MB rather than 2.5 GB, and the difference
# is entirely a training framework that inference does not need.
#
# tests/test_runtime_boundary asserts the boundary in Python; this Dockerfile is
# where it costs something if it is wrong, because the image simply will not
# start.
#
#   docker build -f docker/Dockerfile.runtime -t edgeinspect:runtime .
#   docker run --rm -v "$PWD/models:/app/models" -v "$PWD/artifacts:/app/artifacts" \
#       edgeinspect:runtime python scripts/simulate_edge.py --stream clean --frames 120

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    EDGEINSPECT_ROOT=/app

WORKDIR /app

# Only what the runtime imports.  Pinned to the same floors as
# requirements.txt; the training and development extras are deliberately absent
# and their absence is what the image is for.
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
      "numpy>=1.26,<3" \
      "scipy>=1.11,<2" \
      "pyyaml>=6.0" \
      "pillow>=10.0" \
      "onnx>=1.16" \
      "onnxruntime>=1.18"

COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY configs/ /app/configs/
COPY pyproject.toml /app/

# Fail the build rather than the first production start.  An accidental
# `import torch` three modules deep otherwise ships and breaks on the device.
RUN python - <<'PYTHON'
import sys
import edgeinspect.edge.runtime          # noqa: F401
import edgeinspect.edge.agent            # noqa: F401
import edgeinspect.monitoring            # noqa: F401
import edgeinspect.registry              # noqa: F401
leaked = sorted(m for m in sys.modules if m.split(".")[0] in ("torch", "mlflow"))
if leaked:
    raise SystemExit("the runtime image imports " + ", ".join(leaked))
print("runtime boundary holds")
PYTHON

# A non-root user, because a device runtime that runs as root is one container
# escape away from the rest of the line.
RUN useradd --create-home --uid 10001 edge \
 && mkdir -p /app/artifacts /app/results /app/models \
 && chown -R edge:edge /app
USER edge

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import edgeinspect.edge.runtime" || exit 1

CMD ["python", "scripts/simulate_edge.py", "--stream", "clean", "--frames", "120"]
